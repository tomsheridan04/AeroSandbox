% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (opt);
\chainin (geom) [join=by ProcessHVA];
\chainin (stab) [join=by ProcessHVA];
\chainin (cruise) [join=by ProcessHVA];
\chainin (stall) [join=by ProcessHVA];
\chainin (turn) [join=by ProcessHVA];
\chainin (climb) [join=by ProcessHVA];
\chainin (vmax) [join=by ProcessHVA];
\chainin (drag) [join=by ProcessHVA];
\chainin (prop) [join=by ProcessHVA];
\chainin (battery) [join=by ProcessHVA];
\chainin (weights) [join=by ProcessHVA];
\chainin (score) [join=by ProcessHVA];
\chainin (opt) [join=by ProcessHVA];
\end{pgfonlayer}
}

